  <rdf:Description rdf:nodeID="n4a6f12b1c05e4930b61c0d6900a4ff1bb24">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:resource="http://purl.org/vocab/frbr/core#Work"/>
