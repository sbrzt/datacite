  <rdf:Description rdf:nodeID="n4a6f12b1c05e4930b61c0d6900a4ff1bb54">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
    <owl:members rdf:nodeID="n4a6f12b1c05e4930b61c0d6900a4ff1bb55"/>
