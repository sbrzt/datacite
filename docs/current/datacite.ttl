                owl:NamedIndividual ;
        rdfs:label "text"@en ;
        rdfs:comment "A resource consisting primarily of words for reading."@en ;
        skos:scopeNote """
Examples include books, letters, dissertations, poems, newspapers, articles, archives of mailing lists. Note that facsimiles or images of texts are still of the genre Text.
        """@en ;
        vann:example """
        :my-resource a dcmitype:Text .
        """ ;
        vaem:rationale """
This is used as a controlled term to specify a given general resource type.
        """@en ;
        rdfs:isDefinedBy <http://purl.org/dc/dcmitype/> ;
        vs:term_status "stable"@en .


#################################################################
#    General axioms
#################################################################

[ a owl:AllDisjointClasses ;
  owl:members ( datacite:FunderIdentifier>
                datacite:PersonalIdentifier>
                datacite:ResourceIdentifier>
              )
] .


