        vann:example """
        :relation-dataset-article a datacite:QualifiedRelation ;
                datacite:hasRelationCharacterization cito:isCitedBy .
        """ ;
        rdfs:comment "The cited entity (the subject of the RDF triple) is cited by the citing entity (the object of the triple)."@en ;
        rdfs:isDefinedBy <http://purl.org/spar/cito> ;
        rdfs:label "is cited by"@en ;
        vaem:rationale """
This is used in combination with OWL punning to characterise the type of an instance of datacite:QualifiedRelation via the property datacite:hasRelationCharacterization.
        """@en ;
        vs:term_status "stable"@en .


