        vaem:rationale """
This is used as a controlled term to specify a given agent role type ('Rights Holder').
        """@en ;
        rdfs:seeAlso <http://purl.org/spar/scoro/patent-holder> ,
                <http://purl.org/spar/pro/copyright-owner> ;
        vs:term_status "stable"@en .


