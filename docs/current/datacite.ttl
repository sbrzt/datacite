datacite:lattes a owl:NamedIndividual ,
                datacite:AgentIdentifierScheme ;
        fabio:hasURL "https://lattes.cnpq.br/"^^xsd:anyURI ;
        vann:example """
        :marcos-bagno-id
                datacite:usesIdentifierScheme datacite:lattes ;
